{
  "name": "velocita-browser",
  "version": "1.1.0",
  "description": "Velocita Web Browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  },
  "build": {
    "appId": "com.velocita.browser",
    "productName": "Velocita",
    "protocols": [
      {
        "name": "Velocita",
        "schemes": ["velocita"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis"],
      "icon": "assets/velocita.ico"
    },
    "nsis": {
      "installerIcon": "assets/velocita.ico",
      "uninstallerIcon": "assets/velocita.ico"
    },
    "files": [
      "**/*"
    ]
  }
}